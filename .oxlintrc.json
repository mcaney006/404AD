{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": { "browser": true, "es2024": true },
  "rules": {
    "no-console": "off",
    "typescript/no-explicit-any": "warn",
    // Page-realm globals are named __404AD_* deliberately. The scriptlet
    // runtime shares a namespace with arbitrary site code, and the dunder
    // prefix is what keeps the two from colliding.
    "eslint/no-underscore-dangle": "off",
    // Every flagged sort runs on an array this code just built. `toSorted()`
    // would allocate a second copy to avoid mutating something nobody holds.
    "unicorn/no-array-sort": "off",
    // The rule's advice is Promise.all, which is wrong wherever the loop is
    // ordered by necessity: reading a stream, or recompiling the dynamic rule
    // set once per removal so two updateDynamicRules calls cannot race.
    "eslint/no-await-in-loop": "off"
  },
  "ignorePatterns": [
    "packages/extension/src/wasm/**",
    "packages/extension/.output/**",
    "packages/extension/.wxt/**",
    "dist/**",
    "target/**"
  ]
}
