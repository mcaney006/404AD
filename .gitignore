/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/Cargo.lock

# OS
.DS_Store

# Chromium writes verification metadata into an unpacked extension directory
# when it loads one. It is browser state, not build output.
dist/**/_metadata/
